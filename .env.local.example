# LendRail local development environment variables
# Copy this file to .env.local and fill in any blank values.
# DO NOT commit .env.local to version control.

# --- Database ---
# asyncpg connection string for PostgreSQL 16
DATABASE_URL=postgresql+asyncpg://lendrail:lendrail@postgres:5432/lendrail

# Enable SQLAlchemy query logging (set true only for debugging, very verbose)
DB_ECHO=false

# --- Redis / ARQ ---
REDIS_URL=redis://redis:6379

# --- Auth / JWT ---
# Change this to a strong random secret in production. Never reuse across environments.
JWT_SECRET=local-dev-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# --- Secret store ---
# "env" = in-process AES-256 store (M0 only, not durable across restarts)
# Production: must be replaced before F-024 (see HARD M2 GATE in app/secrets/env_store.py)
SECRET_STORE=env
# Optional: high-entropy random key for the AES-256 store.
# If unset, falls back to JWT_SECRET (WARNING: rotating JWT_SECRET also invalidates stored ciphertext).
# In production, always set a dedicated SECRET_STORE_KEY.
SECRET_STORE_KEY=

# --- Adapter selection ---
# "mock" for local dev; set to the real provider name (e.g. "anchorage") in production
CUSTODIAN_ADAPTER=mock
MARKET_DATA_ADAPTER=mock
# Fixed BTC price used by the mock market data adapter (USD)
MOCK_BTC_PRICE_USD=65000.0

# --- Notifications ---
# "console" = logs to stdout + writes in-app DB rows (local)
# "resend" = transactional email via Resend (production; requires RESEND_API_KEY)
NOTIFICATION_ADAPTER=console
# RESEND_API_KEY=           # blank locally; set in production

# --- Worker ---
# How often the health-check cron job fires (seconds). Default: 60.
HEALTH_CHECK_INTERVAL_SECONDS=60

# --- App ---
# "local" | "test" | "prod"
ENVIRONMENT=local
LOG_LEVEL=INFO
