{
  "openapi": "3.1.0",
  "info": {
    "title": "LendRail API",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Healthz",
        "operationId": "health_healthz",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "auth_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "description": "Stateless JWT \u2014 no server-side token revocation in M0. Returns 200.",
        "operationId": "auth_logout",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Auth Logout"
                }
              }
            }
          }
        }
      }
    },
    "/orgs/register/supplier": {
      "post": {
        "tags": ["orgs"],
        "summary": "Register a new supplier organization",
        "operationId": "register_supplier",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SupplierRegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful registration",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrgRegisterResponse" }
              }
            }
          },
          "409": { "description": "Duplicate email" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/orgs/register/agent": {
      "post": {
        "tags": ["orgs"],
        "summary": "Register a new agent organization",
        "operationId": "register_agent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AgentRegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful registration",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrgRegisterResponse" }
              }
            }
          },
          "409": { "description": "Duplicate email" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/orgs/me": {
      "get": {
        "tags": ["orgs"],
        "summary": "Get current organization",
        "operationId": "orgs_me",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": true }
              }
            }
          }
        }
      }
    },
    "/borrowers/invite": {
      "post": {
        "tags": ["borrowers"],
        "summary": "Invite a borrower",
        "operationId": "borrowers_invite",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "additionalProperties": true }
            }
          }
        },
        "responses": {
          "201": { "description": "Invitation sent" }
        }
      }
    },
    "/borrowers/{borrower_id}": {
      "get": {
        "tags": ["borrowers"],
        "summary": "Get borrower by ID",
        "operationId": "borrowers_get",
        "parameters": [
          {
            "name": "borrower_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": true }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Me",
        "description": "Protected smoke endpoint for F-004/F-005 tests.",
        "operationId": "auth_me",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Auth Me"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "TokenResponse"
      },
      "OrgRegisterResponse": {
        "properties": {
          "org_id": {
            "type": "string",
            "format": "uuid",
            "title": "Org Id"
          },
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": ["org_id", "access_token"],
        "title": "OrgRegisterResponse"
      },
      "SupplierRegisterRequest": {
        "properties": {
          "name": { "type": "string", "title": "Name" },
          "jurisdiction": { "type": "string", "title": "Jurisdiction" },
          "entity_type": {
            "type": "string",
            "enum": ["fund", "corporate_treasury", "foundation"],
            "title": "Entity Type"
          },
          "contact_email": { "type": "string", "format": "email", "title": "Contact Email" },
          "password": { "type": "string", "minLength": 12, "title": "Password" }
        },
        "type": "object",
        "required": ["name", "jurisdiction", "entity_type", "contact_email", "password"],
        "title": "SupplierRegisterRequest"
      },
      "AgentRegisterRequest": {
        "properties": {
          "name": { "type": "string", "title": "Name" },
          "jurisdiction": { "type": "string", "title": "Jurisdiction" },
          "entity_type": {
            "type": "string",
            "enum": ["fund", "corporate_treasury", "foundation"],
            "title": "Entity Type"
          },
          "contact_email": { "type": "string", "format": "email", "title": "Contact Email" },
          "ops_contact_email": { "type": "string", "format": "email", "title": "Ops Contact Email" },
          "password": { "type": "string", "minLength": 12, "title": "Password" },
          "regulatory_status_attested": { "type": "boolean", "title": "Regulatory Status Attested" }
        },
        "type": "object",
        "required": ["name", "jurisdiction", "entity_type", "contact_email", "ops_contact_email", "password", "regulatory_status_attested"],
        "title": "AgentRegisterRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}